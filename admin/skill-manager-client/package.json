{
  "name": "skills-manager-client",
  "version": "0.0.0",
  "description": "Local-first Skill classification and management client",
  "author": "cm",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "desktop": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --mac dir"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "lucide-react": "^1.51.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.cm.skillatlas",
    "productName": "Skill Atlas",
    "asar": true,
    "files": ["dist/client/**/*", "electron/**/*", "package.json"],
    "directories": { "output": "release" },
    "mac": {
      "target": [{ "target": "dir", "arch": ["arm64"] }],
      "category": "public.app-category.developer-tools"
    }
  }
}
