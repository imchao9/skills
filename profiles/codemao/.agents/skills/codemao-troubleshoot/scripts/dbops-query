const LOGIN_PATH_KEYWORD = '/login';
const REQUIRED_COOKIE_NAMES = new Set(['csrftoken']);
const AUTH_COOKIE_NAME_CANDIDATES = ['sessionid', 'internal_account_token', 'admin-authorization', 'authorization'];
const RETRYABLE_HTTP_STATUSES = new Set([408, 425, 429, 500, 502, 503, 504]);
const PERMISSION_KEYWORDS = [
  'permission',
  'forbidden',
  'denied',
  'unauthorized',
  '没有权限',
  '无权限',
  '权限不足',
];
const SQL_ALLOWED_PREFIXES = ['select ', 'show ', 'desc ', 'describe ', 'explain '];
const SQL_BLOCKED_PREFIXES = [
  'insert ',
  'update ',
  'delete ',
  'drop ',
  'alter ',
  'create ',
  'truncate ',
  'replace ',
  'merge ',
  'call ',
  'grant ',
  'revoke ',
];

const KNOWN_COMMANDS = new Set([
  'auth',
  'query-on',
  'instances',
  'resources',
  'querylog',
  'queryloginfo',
  'favorites',
  'favorite-list',
  'favorite-find',
  'favorite',
  'unfavorite',
  'favorite-info',
  'favorite-run',
  'favorite-query',
  'api',
]);

