function normalizedJsonPath(requestPath) {
  const normalized = requestPath.startsWith('/') ? requestPath : `/${requestPath}`;
  return normalized.startsWith('/query/') || normalized.startsWith('/instance/') || normalized.startsWith('/group/');
}

async function runApi(argv) {
  if (argv.length < 3) throw new CliError('invalid_argument', 'Usage: dbops-query api <GET|POST> <path> [key=value ...]', { exitCode: 2 });
  const config = getRuntimeConfig();
  const method = argv[1];
  const requestPath = argv[2];
  const params = parseKeyValues(argv.slice(3));
  if (normalizedJsonPath(requestPath)) {
    const result = await performJsonRequest(() => buildApiRequest(config, method, requestPath, params));
    printJson({ http_status: result.status, payload: result.payload });
    return;
  }
  const result = await performTextRequest(() => buildApiRequest(config, method, requestPath, params));
  printJson({ http_status: result.status, content_type: result.contentType, body: result.bodyText });
}

function parseAuthArgs(argv) {
  const args = {
    baseUrl: dbopsBaseUrl(),
    cookieFile: DEFAULT_COOKIE_FILE,
    storageState: DEFAULT_STORAGE_STATE,
    authCheckUrl: dbopsAuthCheckUrl(),
    targetUrl: dbopsLoginPageUrl(),
    loginTimeout: DEFAULT_LOGIN_TIMEOUT_SECONDS,
  };
  for (let index = 1; index < argv.length; index += 1) {
    const key = argv[index];
    const value = argv[index + 1];
    if (key === '--login-timeout') { args.loginTimeout = Number(value); index += 1; continue; }
    if (key === '-h' || key === '--help') {
      process.stdout.write('usage: dbops-query auth [--login-timeout SECONDS]\n');
      return null;
    }
    throw new CliError('invalid_argument', `unknown argument: ${key}`, { exitCode: 2 });
  }
  return args;
}

async function resolvePlaywrightModulePath() {
  try {
    return path.dirname(require.resolve('playwright/package.json'));
  } catch {
  }
  const root = path.join(os.homedir(), '.npm', '_npx');
  const entries = await fsp.readdir(root, { withFileTypes: true }).catch(() => []);
  const candidates = [];
  for (const entry of entries) {
    if (!entry.isDirectory()) continue;
    const packagePath = path.join(root, entry.name, 'node_modules', 'playwright', 'package.json');
    try {
      const stat = await fsp.stat(packagePath);
      candidates.push({ packagePath, mtimeMs: stat.mtimeMs });
    } catch {
    }
  }
  candidates.sort((a, b) => b.mtimeMs - a.mtimeMs);
  if (!candidates.length) {
    throw new CliError('playwright_missing', 'Playwright library package not found. Run scripts/skillctl setup --install or paste cookie into output/dbops-auth-cookie.txt manually.');
  }
  return path.dirname(candidates[0].packagePath);
}

function installBrowserAuthCloseHandlers(context, settleError) {
  let pageCount = 0;

  function cancelAuth() {
    settleError(new Error('登录已取消或浏览器已关闭，auth 已停止。'));
  }

  function markPage(page) {
    if (!page || typeof page.once !== 'function') return;
    if (typeof page.isClosed === 'function' && page.isClosed()) return;
    pageCount += 1;
    page.once('close', () => {
      pageCount = Math.max(0, pageCount - 1);
      if (pageCount === 0) cancelAuth();
    });
  }

  context.once('close', cancelAuth);
  const browser = context.browser();
  if (browser) browser.once('disconnected', cancelAuth);
  for (const page of context.pages()) markPage(page);
  context.on('page', markPage);

  return {
    markPage,
    getPageCount: () => pageCount,
  };
}

function hostFromUrl(url) {
  return new URL(url).hostname;
}

function isCodemaoCookie(cookie) {
  const domain = String(cookie.domain || '').replace(/^\./, '');
  return domain === 'codemao.cn' || domain.endsWith('.codemao.cn');
}

function isDbopsCookie(cookie, baseUrl) {
  const domain = String(cookie.domain || '').replace(/^\./, '');
  return domain === hostFromUrl(baseUrl) || isCodemaoCookie(cookie);
}

function cookieNames(cookies) {
  return cookies.map((cookie) => String(cookie.name || '')).filter(Boolean);
}

function missingRequiredCookies(cookies) {
  const names = new Set(cookieNames(cookies));
  const missing = Array.from(REQUIRED_COOKIE_NAMES).filter((name) => !names.has(name));
  if (!AUTH_COOKIE_NAME_CANDIDATES.some((name) => names.has(name))) {
    missing.push(`one of ${AUTH_COOKIE_NAME_CANDIDATES.join('/')}`);
  }
  return missing;
}

function hasRequiredCookies(cookies) {
  return missingRequiredCookies(cookies).length === 0;
}

function buildCookieHeader(cookies) {
  return cookies.map((cookie) => `${cookie.name}=${cookie.value}`).join('; ');
}

function normalizeUrlForCompare(urlValue) {
  const url = new URL(urlValue);
  url.hash = '';
  return url.toString();
}

function looksLikeDbopsSuccess(response, args) {
  if (!response.ok()) return false;
  return normalizeUrlForCompare(response.url()) === normalizeUrlForCompare(args.authCheckUrl);
}

function dbopsAuthOutputPath(filePath) {
  const relative = path.relative(SKILL_ROOT, filePath);
  return relative && !relative.startsWith('..') ? relative : filePath;
}

function isDocumentResponse(response) {
  const request = response.request && response.request();
  if (!request || typeof request.resourceType !== 'function') return false;
  return request.resourceType() === 'document';
}

function shouldNavigateToSqlquery(response, args) {
  if (!response.ok() || !isDocumentResponse(response)) return false;
  const url = new URL(response.url());
  const baseUrl = new URL(args.baseUrl);
  if (url.origin !== baseUrl.origin) return false;
  if (normalizeUrlForCompare(url.toString()) === normalizeUrlForCompare(args.authCheckUrl)) return false;
  return url.pathname.replace(/\/+$/, '') !== '/sqlquery';
}

function cleanupTempProfileDetached(tempRoot) {
  if (!tempRoot) return;
  const child = spawn(process.execPath, [
    '-e',
    [
      "const fs = require('node:fs/promises');",
      "const os = require('node:os');",
      "const path = require('node:path');",
      '',
      '(async () => {',
      "  const dir = path.resolve(process.argv[1] || '');",
      '  const tmp = path.resolve(os.tmpdir());',
      '  const basename = path.basename(dir);',
      "  if (!dir.startsWith(tmp + path.sep) || !/^codemao-dbops-auth-login-[^/]+$/.test(basename)) return;",
      '  const delays = [500, 1000, 2000, 4000, 8000, 8000];',
      '  for (const delay of delays) {',
      '    await new Promise((resolve) => setTimeout(resolve, delay));',
      '    try {',
      '      await fs.rm(dir, { recursive: true });',
      '      return;',
      '    } catch {',
      '    }',
      '  }',
      '})().catch(() => {});',
    ].join('\n'),
    tempRoot,
  ], {
    detached: true,
    stdio: 'ignore',
  });
  child.unref();
}

function closeAndCleanupDetached(context, tempRoot) {
  if (context) context.close().catch(() => {});
  cleanupTempProfileDetached(tempRoot);
}

async function writeAuthFiles(args, cookies) {
  const dbopsCookies = cookies.filter((cookie) => isDbopsCookie(cookie, args.baseUrl));
  const missing = missingRequiredCookies(dbopsCookies);
  if (missing.length) throw new CliError('auth_cookie_missing', `required dbops cookies are missing: ${missing.join(', ')}`);
  const cookieHeader = buildCookieHeader(dbopsCookies);
  const generatedAt = new Date().toISOString();
  const names = cookieNames(dbopsCookies);
  await fsp.mkdir(path.dirname(args.cookieFile), { recursive: true });
  await fsp.mkdir(path.dirname(args.storageState), { recursive: true });
  await fsp.writeFile(args.storageState, `${JSON.stringify({ cookies: dbopsCookies, origins: [] }, null, 2)}\n`, 'utf8');
  await fsp.writeFile(args.cookieFile, [
    '# dbops auth cookie file',
    `# generated_at: ${generatedAt}`,
    '# source: playwright-node-dbops-query-auth',
    `# storage_state_path: ${args.storageState}`,
    `# cookie_names: ${names.join(', ')}`,
    '# Replace the final line with a complete Cookie header to update manually.',
    cookieHeader,
    '',
  ].join('\n'), 'utf8');
  return {
    base_url: args.baseUrl,
    generated_at: generatedAt,
    source: 'playwright-node-dbops-query-auth',
    cookie_file_path: args.cookieFile,
    storage_state_path: args.storageState,
    cookie_count: dbopsCookies.length,
    cookie_names: names,
    has_required_cookies: true,
    missing_required_cookies: [],
  };
}

async function runAuth(argv) {
  const args = parseAuthArgs(argv);
  if (!args) return;
  const playwrightModulePath = await resolvePlaywrightModulePath();
  const { chromium } = require(playwrightModulePath);
  const userDataDir = await fsp.mkdtemp(path.join(os.tmpdir(), 'codemao-dbops-auth-login-'));
  const profileDir = path.join(userDataDir, 'profile');
  const context = await chromium.launchPersistentContext(profileDir, {
    channel: 'chrome',
    headless: false,
    chromiumSandbox: true,
  });
  let settled = false;
  let timeoutId;
  let authWriteInFlight = false;
  let sqlqueryNavigationInFlight = false;
  let sqlqueryNavigationAttempted = false;
  let detachedCleanup = false;
  let settleResolve;
  let settleReject;
  const settledPromise = new Promise((resolve, reject) => {
    settleResolve = resolve;
    settleReject = reject;
  });

  function settleSuccess(payload) {
    if (settled) return;
    settled = true;
    if (timeoutId) clearTimeout(timeoutId);
    settleResolve(payload);
  }
  function settleError(error) {
    if (settled) return;
    settled = true;
    if (timeoutId) clearTimeout(timeoutId);
    settleReject(error);
  }
  async function tryWriteFromContext() {
    if (authWriteInFlight || settled) return false;
    authWriteInFlight = true;
    try {
      const cookies = (await context.cookies()).filter((cookie) => isDbopsCookie(cookie, args.baseUrl));
      if (!hasRequiredCookies(cookies)) return false;
      const result = await writeAuthFiles(args, cookies);
      await writeCompactJson({ step: 'auth-ok', cookie_file: dbopsAuthOutputPath(args.cookieFile) });
      detachedCleanup = true;
      closeAndCleanupDetached(context, userDataDir);
      settleSuccess({ ...result, detachedCleanup: true });
      return true;
    } finally {
      authWriteInFlight = false;
    }
  }
  async function navigateToSqlquery(page) {
    if (settled || sqlqueryNavigationInFlight || sqlqueryNavigationAttempted) return;
    sqlqueryNavigationAttempted = true;
    sqlqueryNavigationInFlight = true;
    try {
      await page.goto(args.targetUrl, { timeout: PLAYWRIGHT_OPEN_TIMEOUT_MS, waitUntil: 'domcontentloaded' }).catch(() => {});
    } finally {
      sqlqueryNavigationInFlight = false;
    }
  }

  try {
    const browserLifecycle = installBrowserAuthCloseHandlers(context, settleError);
    const page = context.pages()[0] || await context.newPage();
    context.on('response', async (response) => {
      if (settled) return;
      try {
        if (looksLikeDbopsSuccess(response, args)) {
          await tryWriteFromContext();
          return;
        }
        if (shouldNavigateToSqlquery(response, args)) await navigateToSqlquery(page);
      } catch (error) {
        settleError(error);
      }
    });
    if (browserLifecycle.getPageCount() === 0) browserLifecycle.markPage(page);
    timeoutId = setTimeout(() => settleError(new Error('登录等待超时，auth 已停止。')), Math.max(1, args.loginTimeout) * 1000);
    await page.goto(args.targetUrl, { timeout: PLAYWRIGHT_OPEN_TIMEOUT_MS, waitUntil: 'domcontentloaded' }).catch(() => {});
    await writeCompactJson({ step: 'auth-opened' });
    const result = await settledPromise;
    if (result && result.detachedCleanup) return 'detached-exit';
    return result;
  } finally {
    if (!detachedCleanup) {
      await context.close().catch(() => {});
      await fsp.rm(userDataDir, { recursive: true }).catch(() => {});
    }
  }
}

async function main(argv) {
  const validation = validateArgs(argv);
  if (validation.help) {
    printUsage(process.stdout);
    return 0;
  }
  if (validation.helpCommand) {
    printCommandHelp(validation.helpCommand);
    return 0;
  }
  if (validation.usage) {
    printUsage();
    return 1;
  }
  const command = argv[0];
  if (command === 'auth') {
    const result = await runAuth(argv);
    if (result === 'detached-exit') process.exit(0);
    return 0;
  }
  if (command === 'query-on') { await runQueryOn(argv); return 0; }
  if (command === 'instances') { await runInstances(argv); return 0; }
  if (command === 'resources') { await runResources(argv); return 0; }
  if (command === 'querylog') { await runQuerylog(argv); return 0; }
  if (command === 'queryloginfo') { await runQueryloginfo(argv); return 0; }
  if (command === 'favorites' || command === 'favorite-list') { await runFavorites(argv); return 0; }
  if (command === 'favorite-find') { await runFavoriteFind(argv); return 0; }
  if (command === 'favorite') { await runFavorite(argv); return 0; }
  if (command === 'unfavorite') { await runUnfavorite(argv); return 0; }
  if (command === 'favorite-info') { await runFavoriteInfo(argv); return 0; }
  if (command === 'favorite-run') { await runFavoriteRun(argv); return 0; }
  if (command === 'favorite-query') { await runFavoriteQuery(argv); return 0; }
  if (command === 'api') { await runApi(argv); return 0; }
  return await runQuery(argv);
}

if (require.main === module) {
  main(process.argv.slice(2)).then((exitCode) => {
    process.exitCode = exitCode;
  }).catch((error) => {
    if (error instanceof CliError) {
      process.stderr.write(`${error.toString()}\n`);
      process.exitCode = error.exitCode;
      return;
    }
    process.stderr.write(`[unexpected_error] non-retryable: ${error && error.message ? error.message : String(error)}\n`);
    process.exitCode = 1;
  });
}

module.exports = {
  checkReadonlySql,
  validateArgs,
  dbopsLoginPageUrl,
  dbopsAuthCheckUrl,
  shouldNavigateToSqlquery,
  dbopsAuthOutputPath,
  readCookieFromFile,
  missingRequiredCookies,
  installBrowserAuthCloseHandlers,
  writeAuthFiles,
};
