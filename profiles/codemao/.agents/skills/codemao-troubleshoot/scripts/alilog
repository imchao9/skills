// CLI argument policy
function topLevelUsage() {
  return [
    'usage: scripts/alilog auth [--project PROJECT --logstore LOGSTORE] [--no-auto-fill] [--timeout SECONDS] [--profile-dir DIR] [--debug]',
    '       scripts/alilog query --project PROJECT --logstore LOGSTORE --query QUERY (--time EXPR | --from TIME --to TIME) [--page N] [--size N] [--expand-sql] [--continue INDEX:OFFSET] [--select-fields FIELDS] [--extra-fields FIELDS]',
    '       scripts/alilog fields --project PROJECT --logstore LOGSTORE --query QUERY (--time EXPR | --from TIME --to TIME)',
    '       scripts/alilog logstores --project PROJECT [--keyword KEYWORD] [--page N] [--page-size N]',
    '       scripts/alilog index-fields --project PROJECT --logstore LOGSTORE',
    '',
    'commands:',
    '  auth       capture SLS auth cookie and CSRF through browser login',
    '  query      query SLS logs or SLS SQL with compact output',
    '  fields     sample logs and list observed fields',
    '  logstores  search logstores in a project',
    '  index-fields  get the current logstore index configuration',
  ].join('\n');
}

function authUsage() {
  return [
    'usage: scripts/alilog auth [--project PROJECT --logstore LOGSTORE] [--no-auto-fill] [--timeout SECONDS] [--profile-dir DIR] [--debug]',
    '',
    'Uses automatic Aliyun login in a headless browser when complete supported local credentials are available; otherwise opens Chrome. Captures auth cookie and CSRF into output/alilog-auth.json.',
    'project/logstore are target hints for opening a useful SLS page; missing target still can be a successful auth if cookie and CSRF are captured.',
    '',
    'options:',
    '  --project PROJECT       target hint project; default kuebernetes-production',
    '  --logstore LOGSTORE     target hint logstore; default production',
    '  --no-auto-fill          do not fill local username/password/TOTP',
    '  --timeout SECONDS       login wait timeout',
    '  --profile-dir DIR       diagnostic only; reuse an explicit Chrome profile dir',
    '  --debug                 print auth lifecycle details without printing secrets',
  ].join('\n');
}

