  return [
    'usage: scripts/alilog query --project PROJECT --logstore LOGSTORE --query QUERY (--time EXPR | --from TIME --to TIME) [--page N] [--size N] [--expand-sql] [--continue INDEX:OFFSET] [--select-fields FIELDS] [--extra-fields FIELDS]',
    '',
    'query output: default prints compact header and body; body prefers message, then content, then summary; one body is limited to 200 chars and total output to 3000 chars.',
    '  search hint: search request id, TID text, or internal log text in indexed content; confirm real fields with fields before --extra-fields.',
