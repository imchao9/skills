async function injectLoginGuidanceNotice(page, message) {
  await page.evaluate((noticeMessage) => {
    if (!document.body) return;
    const noticeId = 'alilog-login-guidance-notice';
    let notice = document.querySelector(`#${noticeId}`);
    if (!notice) {
      notice = document.createElement('div');
      notice.id = noticeId;
      notice.style.position = 'fixed';
      notice.style.top = '18px';
      notice.style.left = '50%';
      notice.style.transform = 'translateX(-50%)';
      notice.style.width = '470px';
      notice.style.maxWidth = 'calc(100% - 32px)';
      notice.style.zIndex = '2147483646';
      notice.style.padding = '13px 14px';
      notice.style.background = '#fff4cc';
      notice.style.border = '1px solid #f59e0b';
      notice.style.borderLeft = '4px solid #ea580c';
      notice.style.borderRadius = '8px';
      notice.style.color = '#332100';
      notice.style.fontSize = '15px';
      notice.style.lineHeight = '22px';
      notice.style.fontWeight = '600';
      notice.style.whiteSpace = 'pre-line';
      notice.style.boxShadow = '0 12px 30px rgba(71, 42, 0, 0.24)';
      notice.style.boxSizing = 'border-box';
      document.body.prepend(notice);
    }
    notice.textContent = noticeMessage;
    if (!('alilogOriginalPaddingTop' in document.body.dataset)) {
      document.body.dataset.alilogOriginalPaddingTop = document.body.style.paddingTop || '';
    }
    const originalPadding = parseFloat(document.body.dataset.alilogOriginalPaddingTop || '0') || 0;
    document.body.style.paddingTop = `${originalPadding + notice.offsetHeight}px`;
  }, message);
}

function usernameInputSelectors() {
  return [
    '#loginName',
    'input[name="username"]',
    'input[autocomplete="username"]',
  ];
}

function passwordInputSelectors() {
  return [
    '#loginPassword',
    'input[name="password"]',
    'input[type="password"]',
    'input[autocomplete="current-password"]',
  ];
}

function totpInputSelectors(args) {
  return compact([
    args.totpInputSelector,
    'input[placeholder="请输入 6 位数字安全码"]',
  ]);
}

function phoneCodeInputSelectors() {
  return [
    '#PHONE_CODE',
    'input[placeholder="请输入 6 位数字验证码"]',
  ];
}

// DOM helpers for login policy
async function safeInputValue(locator) {
  try {
    return await locator.inputValue({ timeout: 0 });
  } catch (error) {
    return '';
  }
}

function compact(values) {
  return values.filter(Boolean);
}

async function findFirstVisibleLocatorNow(page, selectors) {
  // 只读取当前 DOM 状态；页面阶段变化交给外层短 tick 处理，不在 selector 内部等待。
  for (const selector of selectors) {
    const locator = page.locator(selector).first();
    try {
      if (await locator.isVisible({ timeout: 0 })) return locator;
    } catch (error) {
    }
  }
  return null;
}

function normalizeResult(data) {
  if (!data || typeof data !== 'object') return data;
  const logs = extractPayloadLogs(data);
  const count = Array.isArray(logs) ? logs.length : undefined;
  return {
    ok: data.success !== false,
    count,
    raw: data,
  };
}

function buildLogQuery(args) {
  return args.query;
}

function buildQueryBody(args) {
  const { from, to } = resolveTimeRange(args);
  if (from >= to) throw new Error('--from must be earlier than --to');
  const query = buildLogQuery(args);
  return {
    scope: {
      project: args.project,
      logstore: args.logstore,
      from,
      to,
      query,
      page: args.page,
      size: args.size,
    },
    body: new URLSearchParams({
      LogStoreName: args.logstore,
      ProjectName: args.project,
      from: String(from),
      query,
      to: String(to),
      Page: String(args.page),
      Size: String(args.size),
    }).toString(),
  };
}

function buildLogstoresRequest(args) {
  const url = new URL(`${SLS_BASE_URL}${SLS_LOGSTORE_LIST_PATH}`);
  url.searchParams.set('IsListOnly', '1');
  url.searchParams.set('LogStoreName', args.keyword || '');
  url.searchParams.set('Page', String(args.page));
  url.searchParams.set('Size', String(args.pageSize));
  url.searchParams.set('ProjectName', args.project);
  url.searchParams.set('telemetryType', 'None');
  return url.toString();
}

function buildIndexFieldsRequest(args) {
  const url = new URL(`${SLS_BASE_URL}${SLS_INDEX_CONFIG_PATH}`);
  url.searchParams.set('ProjectName', args.project);
  url.searchParams.set('LogStoreName', args.logstore);
  return url.toString();
}

function isPlainObject(value) {
  if (!value || typeof value !== 'object' || Array.isArray(value)) return false;
  const prototype = Object.getPrototypeOf(value);
  return prototype === Object.prototype || prototype === null;
}

function pruneIndexConfigValue(value) {
  if (Array.isArray(value)) return value.map(pruneIndexConfigValue);
  if (!isPlainObject(value)) return value;
  const result = {};
  for (const [key, child] of Object.entries(value)) {
    if (child === '' || child === null) continue;
    Object.defineProperty(result, key, {
      value: pruneIndexConfigValue(child),
      enumerable: true,
      writable: true,
      configurable: true,
    });
  }
  return result;
}

function parseIndexFieldsResponse(payload) {
  if (!isPlainObject(payload) || payload.success !== true) {
    throw new Error('index request failed: success=false');
  }
  let config = payload.data;
  if (typeof config === 'string') {
    try {
      config = JSON.parse(config);
    } catch (error) {
      throw new Error('invalid index response: data is not valid JSON');
    }
  }
  if (!isPlainObject(config)) {
    throw new Error('invalid index response: data must be an object');
  }
  const result = pruneIndexConfigValue(config);
  for (const key of SLS_INDEX_CONFIG_TOP_LEVEL_OMIT) delete result[key];
  return result;
}

function buildCookieHeader(cookies) {
  return cookies.map((cookie) => `${cookie.name}=${cookie.value}`).join('; ');
}

// Query auth file and SLS request
async function writeAuthFile(args, page, context, csrfToken, dependencies = {}) {
  const fileSystem = dependencies.fileSystem || fs;
  const randomUuid = dependencies.randomUUID || crypto.randomUUID;
  const cookies = await context.cookies(SLS_BASE_URL);
  const cookieHeader = buildCookieHeader(cookies);
  if (!cookieHeader) throw new Error('failed to collect Aliyun SLS cookies');

  const payload = {
    generated_at: new Date().toISOString(),
    base_url: SLS_BASE_URL,
    project: args.project,
    logstore: args.logstore,
    referer: buildConsoleUrl(args),
    cookie: cookieHeader,
    csrf_token: csrfToken,
    cookie_names: cookies.map((cookie) => cookie.name),
  };
  const authDirectory = path.dirname(args.authFile);
  const tempFile = path.join(
    authDirectory,
    `.${path.basename(args.authFile)}.${process.pid}.${randomUuid()}.tmp`,
  );
  let fileHandle;
  try {
    await fileSystem.mkdir(authDirectory, { recursive: true });
    fileHandle = await fileSystem.open(tempFile, 'wx', 0o600);
    await fileHandle.chmod(0o600);
    await fileHandle.writeFile(`${JSON.stringify(payload, null, 2)}\n`, 'utf8');
    await fileHandle.close();
    fileHandle = null;
    await fileSystem.rename(tempFile, args.authFile);
    return payload;
  } catch (error) {
    if (fileHandle) await fileHandle.close().catch(() => {});
    await fileSystem.rm(tempFile, { force: true }).catch(() => {});
    throw error;
  }
}

async function readAuthFile(args) {
  let payload;
  try {
    payload = JSON.parse(await fs.readFile(args.authFile, 'utf8'));
  } catch (error) {
    throw new Error(`failed to read auth file; run scripts/alilog auth first: ${args.authFile}`);
  }
  if (!payload.cookie || !payload.csrf_token) {
    throw new Error(`auth file is missing cookie or csrf_token; refresh it with scripts/alilog auth: ${args.authFile}`);
  }
  return payload;
}

async function queryLogsWithAuthFile(args, dependencies = {}) {
  const loadAuth = dependencies.readAuthFile || readAuthFile;
  const requestWithTimeout = dependencies.fetchWithTimeout || fetchWithTimeout;
  const auth = await loadAuth(args);
  const request = buildQueryBody(args);
  const response = await requestWithTimeout(`${SLS_BASE_URL}${SLS_GET_LOGS_INDEX_PATH}`, {
    method: 'POST',
    headers: {
      accept: 'application/json',
      'content-type': 'application/x-www-form-urlencoded',
      cookie: auth.cookie,
      origin: SLS_BASE_URL,
      referer: auth.referer || buildConsoleUrl(args),
      'x-csrf-token': auth.csrf_token,
    },
    body: request.body,
  });
  if (response.status === 401 || response.status === 403) {
    throw new Error('auth expired or invalid; run scripts/alilog auth');
  }
  const command = args.command === 'fields' ? 'fields' : 'query';
  const text = await response.text();
  let payload = null;
  try {
    payload = JSON.parse(text);
  } catch (error) {
    if (!response.ok) {
      throw new Error(`${command} request failed: status=${response.status}`);
    }
    throw new Error(`invalid ${command} response: response is not valid JSON`);
  }
  if (isPlainObject(payload)
    && (String(payload.code || '') === 'ConsoleNeedLogin'
      || String(payload.message || '') === 'ConsoleNeedLogin')) {
    throw new Error('auth expired or invalid; run scripts/alilog auth');
  }
  if (!response.ok) {
    throw new Error(`${command} request failed: status=${response.status}`);
  }
  if (!isPlainObject(payload)) {
    throw new Error(`invalid ${command} response: response must be an object`);
  }
  if (payload.success === false) {
    const code = payload.code === undefined ? '' : ` code=${compactDisplayText(payload.code)}`;
    const message = payload.message === undefined ? '' : ` message=${formatErrorMessage(payload.message)}`;
    throw new Error(redactAlilogText(`${command} request failed:${code}${message}`));
  }
  if (payload.success !== true) {
    throw new Error(`invalid ${command} response: success must be true`);
  }
  return {
    scope: request.scope,
    response: {
      status: response.status,
      ok: response.ok,
    },
    result: normalizeResult(payload),
  };
}

async function listLogstoresWithAuthFile(args, dependencies = {}) {
  const loadAuth = dependencies.readAuthFile || readAuthFile;
  const requestWithTimeout = dependencies.fetchWithTimeout || fetchWithTimeout;
  const auth = await loadAuth(args);
  const response = await requestWithTimeout(buildLogstoresRequest(args), {
    method: 'GET',
    headers: {
      accept: 'application/json',
      cookie: auth.cookie,
      referer: auth.referer || `${SLS_BASE_URL}/`,
    },
  });
  if (response.status === 401 || response.status === 403) {
    throw new Error('auth expired or invalid; run scripts/alilog auth');
  }
  const text = await response.text();
  let payload = null;
  try {
    payload = JSON.parse(text);
  } catch (error) {
    if (!response.ok) {
      throw new Error(`logstores request failed: status=${response.status}`);
    }
    throw new Error('invalid logstores response: response is not valid JSON');
  }
  if (isPlainObject(payload)
    && (String(payload.code || '') === 'ConsoleNeedLogin'
      || String(payload.message || '') === 'ConsoleNeedLogin')) {
    throw new Error('auth expired or invalid; run scripts/alilog auth');
  }
  if (!response.ok) {
    throw new Error(`logstores request failed: status=${response.status}`);
  }
  if (!isPlainObject(payload)) {
    throw new Error('invalid logstores response: response must be an object');
  }
  if (payload.success === false) {
    const code = payload.code === undefined ? '' : ` code=${compactDisplayText(payload.code)}`;
    const message = payload.message === undefined ? '' : ` message=${formatErrorMessage(payload.message)}`;
    throw new Error(redactAlilogText(`logstores request failed:${code}${message}`));
  }
  if (payload.success !== true) {
    throw new Error('invalid logstores response: success must be true');
  }
  return payload;
}

function isIndexAuthFailure(response, payload) {
  if (response.status === 401 || response.status === 403) return true;
  if (!isPlainObject(payload)) return false;
  return String(payload.code || '') === 'ConsoleNeedLogin'
    || String(payload.message || '') === 'ConsoleNeedLogin';
}

async function getIndexFieldsWithAuthFile(args, dependencies = {}) {
  const loadAuth = dependencies.readAuthFile || readAuthFile;
  const request = dependencies.fetchWithTimeout || fetchWithTimeout;
  let auth;
  try {
    auth = await loadAuth(args);
  } catch (error) {
    throw new Error('auth expired or invalid; run scripts/alilog auth');
  }
  const response = await request(buildIndexFieldsRequest(args), {
    method: 'GET',
    headers: {
      accept: 'application/json',
      cookie: auth.cookie,
      referer: auth.referer || `${SLS_BASE_URL}/`,
      'x-csrf-token': auth.csrf_token,
    },
  });
  const text = await response.text();
  if (response.status === 401 || response.status === 403) {
    throw new Error('auth expired or invalid; run scripts/alilog auth');
  }
  let payload;
  try {
    payload = text ? JSON.parse(text) : null;
  } catch (error) {
    throw new Error('invalid index response: response is not valid JSON');
  }
  if (isIndexAuthFailure(response, payload)) {
    throw new Error('auth expired or invalid; run scripts/alilog auth');
  }
  if (!response.ok) {
    throw new Error(`index request failed: status=${response.status}`);
  }
  return parseIndexFieldsResponse(payload);
}

function formatIndexFieldsOutput(config) {
  return JSON.stringify(config);
}

async function fetchWithTimeout(url, options = {}, timeoutMs = DEFAULT_QUERY_FETCH_TIMEOUT_MS, fetchImpl = fetch) {
  const controller = new AbortController();
  const callerSignal = options.signal;
  let timedOut = false;
  const abortFromCaller = () => {
    controller.abort(callerSignal.reason);
  };
  if (callerSignal) {
    if (callerSignal.aborted) {
      abortFromCaller();
    } else {
      callerSignal.addEventListener('abort', abortFromCaller, { once: true });
    }
  }
  const timeoutId = setTimeout(() => {
    timedOut = true;
    controller.abort();
  }, timeoutMs);

  try {
    return await fetchImpl(url, {
      ...options,
      signal: controller.signal,
    });
  } catch (error) {
    if (error && error.name === 'AbortError' && timedOut) {
      throw new Error(`SLS query request timed out after ${Math.ceil(timeoutMs / 1000)}s`);
    }
    throw error;
  } finally {
    clearTimeout(timeoutId);
    if (callerSignal) {
      callerSignal.removeEventListener('abort', abortFromCaller);
    }
  }
}

function extractPayloadLogs(payload) {
  if (!payload || typeof payload !== 'object') return [];
  if (Array.isArray(payload.logs)) return payload.logs;
  if (payload.data && typeof payload.data === 'object' && Array.isArray(payload.data.logs)) return payload.data.logs;
  if (Array.isArray(payload.data)) return payload.data;
  if (Array.isArray(payload.items)) return payload.items;
  if (Array.isArray(payload.results)) return payload.results;
  return [];
}

// Query output formatting
function extractLogs(output) {
  const raw = output && output.result ? output.result.raw : null;
  return extractPayloadLogs(raw);
}

function fieldValue(log, field) {
  if (!log || typeof log !== 'object') return '';
  const value = log[field];
  if (value === undefined || value === null) return '';
  if (typeof value === 'string') return value;
  return JSON.stringify(value);
}

function displayBody(log) {
  const message = fieldValue(log, 'message');
  if (message) return { label: 'message', value: message };
  const content = fieldValue(log, 'content');
  if (content) return { label: 'content', value: content };
  const summary = fallbackSummaryValue(log);
  if (summary) return { label: 'summary', value: summary };
  const result = resultSummaryValue(log);
  if (result) return { label: 'result', value: result };
  return { label: 'message', value: '' };
}

function containerName(log) {
  return compactDisplayText(fieldValue(log, '_container_name_')) || '-';
}

function fallbackSummaryValue(log) {
  if (!log || typeof log !== 'object') return '';
  const parts = [];
  for (const field of FALLBACK_SUMMARY_FIELDS) {
    const value = fieldValue(log, field);
    if (!value) continue;
    parts.push(`${field}=${value}`);
    if (parts.length >= 8) break;
  }
  return parts.join(' ');
}

function resultSummaryValue(log) {
  if (!log || typeof log !== 'object') return '';
  const parts = [];
  for (const field of Object.keys(log)) {
    if (RESULT_EXCLUDED_FIELDS.has(field)) continue;
    if (field.startsWith('__tag__:')) continue;
    const value = fieldValue(log, field);
    if (!value) continue;
    parts.push(`${field}=${value}`);
    if (parts.length >= 8) break;
  }
  return parts.join(' ');
}

function isMybatisSqlLine(value) {
  const text = String(value || '');
  if (/\b(?:ERROR|Exception|failed)\b/i.test(text)) return false;
  return /\bCreating a new SqlSession\b/.test(text)
    || /==>\s+Preparing:/.test(text)
    || /==>\s+Parameters:/.test(text)
    || /<==\s+Columns:/.test(text)
    || /<==\s+Row:/.test(text)
    || /<==\s+Total:/.test(text)
    || /<==\s+Updates:/.test(text)
    || /\bClosing non transactional SqlSession\b/.test(text);
}

function foldMybatisSqlText(value) {
  const lines = String(value || '').split(/\r?\n/);
  const folded = [];
  let blockLines = [];

  function flushBlock() {
    if (!blockLines.length) return;
    const marker = `[sql x${blockLines.length}]`;
    const original = blockLines.join('\n');
    if (marker.length < original.length) {
      folded.push(marker);
    } else {
      folded.push(...blockLines);
    }
    blockLines = [];
  }

  for (const line of lines) {
    if (isMybatisSqlLine(line)) {
      blockLines.push(line);
      continue;
    }
    flushBlock();
    folded.push(line);
  }
  flushBlock();
  return folded.join('\n');
}

function compactDisplayText(value) {
  return String(value || '')
    .replace(/\r\n?/g, '\n')
    .split('\n')
    .map((line) => line.trim().replace(/[^\S\n]+/g, ' '))
    .join('\n')
    .replace(/\n+/g, '\n')
    .trim();
}

function redactAlilogText(value) {
  let text = redactText(value);
  text = text.replace(
    new RegExp(`(("${ALILOG_SECRET_KEY_TEXT}")\\s*:\\s*)("(?:[^"\\\\]|\\\\.)*"|[^,\\n\\r}\\]]+)`, 'gi'),
    (_match, prefix) => `${prefix}"<redacted>"`,
  );
  text = text.replace(
    new RegExp(`\\b(${ALILOG_SECRET_KEY_TEXT})\\b\\s*([:=])\\s*("[^"]*"|[^\\s,;]+)`, 'gi'),
    (_match, key, separator) => `${key}${separator === ':' ? ': ' : '='}<redacted>`,
  );
  return text.replace(
    /(^|[^\d*])((1[3-9]\d)[ -]\d{4}[ -](\d{4}))(?![\d*])/g,
    (_match, prefix, _phone, head, tail) => `${prefix}${head}****${tail}`,
  );
}

function formatErrorMessage(value) {
  const text = redactAlilogText(compactDisplayText(value));
  if (text.length <= ERROR_MESSAGE_CHAR_LIMIT) return text;
  return `${text.slice(0, ERROR_MESSAGE_CHAR_LIMIT)}... [message truncated]`;
}

function prepareContentForOutput(value, args) {
  const rawText = args.expandSql ? String(value || '') : foldMybatisSqlText(value);
  return redactAlilogText(compactDisplayText(rawText));
}

function renderPreparedContent(text, logIndex, offset, limit) {
  const fragment = text.slice(offset, offset + limit);
  const nextOffset = offset + limit;
  if (nextOffset >= text.length) {
    return fragment;
  }
  return `${fragment}\n[more: --continue ${logIndex}:${nextOffset}]`;
}

function renderContent(value, args, logIndex, offset, limit = DEFAULT_LOG_CHAR_LIMIT) {
  return renderPreparedContent(prepareContentForOutput(value, args), logIndex, offset, limit);
}

function appendOutput(lines, value, state) {
  const text = String(value || '');
  if (state.truncated) return;
  if (state.totalChars + text.length > DEFAULT_TOTAL_CHAR_LIMIT) {
    lines.push('[truncated: narrow --query/--time, use --select-fields, or paginate]');
    state.truncated = true;
    return;
  }
  lines.push(text);
  state.totalChars += text.length;
}

function fieldNames(logs) {
  const fields = new Set();
  for (const log of logs) {
    if (!log || typeof log !== 'object') continue;
    for (const key of Object.keys(log)) fields.add(key);
  }
  return Array.from(fields).sort();
}

function formatFieldsOutput(output) {
  const logs = extractLogs(output);
  const fields = fieldNames(logs);
  return JSON.stringify({ sampled_logs: logs.length, count: fields.length, fields }, null, 2);
}

function formatSelectedFieldValue(value) {
  const text = redactAlilogText(compactDisplayText(value));
  if (text.length <= SELECT_FIELD_CHAR_LIMIT) return text;
  return `${text.slice(0, SELECT_FIELD_CHAR_LIMIT)}\n[field truncated: narrow --select-fields, use default body with --continue]`;
}

function formatSelectedLog(log, fields) {
  return fields
    .filter((field) => !HEADER_FIELD_SET.has(field))
    .map((field) => `${field}: ${formatSelectedFieldValue(fieldValue(log, field))}`)
    .join('\n');
}

function formatContinuation(logs, args) {
  const parsed = parseContinueAt(args.continueAt);
  const log = logs[parsed.index - 1];
  if (!log) return `no log at index ${parsed.index}`;

  const body = displayBody(log);
  const rawText = body.value;
  if (!rawText) return `log ${parsed.index} has no message/content`;
  const text = prepareContentForOutput(rawText, args);
  if (parsed.offset >= text.length) return `log ${parsed.index} has no ${body.label} after offset ${parsed.offset}`;

  return renderPreparedContent(text, parsed.index, parsed.offset, CONTINUE_LOG_CHAR_LIMIT);
}

function formatLogTime(log) {
  const raw = fieldValue(log, '__time__') || fieldValue(log, 'time') || fieldValue(log, '@timestamp');
  if (!raw) return '-';
  let millis;
  if (/^\d+$/.test(raw)) {
    millis = Number(raw) * (raw.length >= 13 ? 1 : 1000);
  } else {
    millis = Date.parse(raw);
  }
  if (!Number.isFinite(millis) || Number.isNaN(millis)) return raw;
  const date = new Date(millis);
  const pad = (value) => String(value).padStart(2, '0');
  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())} ${pad(date.getHours())}:${pad(date.getMinutes())}:${pad(date.getSeconds())}`;
}

function logstoreName(item) {
  if (typeof item === 'string') return item;
  if (!item || typeof item !== 'object') return '';
  return item.LogStoreName || item.logstoreName || item.logstore || item.name || '';
}

function extractLogstoreItems(payload) {
  if (!payload || typeof payload !== 'object') return [];
  if (Array.isArray(payload.LogStores)) return payload.LogStores;
  if (Array.isArray(payload.logstores)) return payload.logstores;
  if (payload.Data && Array.isArray(payload.Data.LogStores)) return payload.Data.LogStores;
  if (payload.data && Array.isArray(payload.data.logStores)) return payload.data.logStores;
  if (payload.data && Array.isArray(payload.data.logstores)) return payload.data.logstores;
  if (Array.isArray(payload.data)) return payload.data;
  return [];
}

function logstoreTotal(payload, names) {
  for (const key of ['Count', 'Total', 'total', 'count']) {
    if (payload && Number.isFinite(Number(payload[key]))) return Number(payload[key]);
  }
  if (payload && payload.data && Number.isFinite(Number(payload.data.total))) return Number(payload.data.total);
  if (payload && payload.Data && Number.isFinite(Number(payload.Data.Total))) return Number(payload.Data.Total);
  return names.length;
}

function formatLogstoresOutput(payload, args) {
  const names = extractLogstoreItems(payload).map(logstoreName).filter(Boolean);
  const total = logstoreTotal(payload, names);
  const nextPage = args.page * args.pageSize < total ? args.page + 1 : null;
  return JSON.stringify({
    total,
    page: args.page,
    page_size: args.pageSize,
    next_page: nextPage,
    logstores: names,
  }, null, 2);
}

function isSuccessfulQueryOutput(output) {
  return Boolean(output && output.response && output.response.ok && output.result && output.result.ok !== false);
}

function appendPageHint(lines, logs, args, state) {
  if (logs.length !== args.size) return;
  appendOutput(lines, `[page=${args.page} size=${args.size} returned=${logs.length}]`, state);
}

function formatQueryOutput(output, args) {
  const logs = extractLogs(output);
  const status = output && output.response ? output.response.status : '';
  if (!isSuccessfulQueryOutput(output)) {
    const raw = output && output.result ? output.result.raw : null;
    const code = raw && raw.code ? ` code=${raw.code}` : '';
    const message = raw && raw.message ? ` message=${formatErrorMessage(raw.message)}` : '';
    return redactAlilogText(`query failed: status=${status}${code}${message}`);
  }
  if (!logs.length) return 'no logs';
  if (args.continueAt) return redactAlilogText(formatContinuation(logs, args));

  const lines = [];
  const state = { totalChars: 0, truncated: false };
  const selectFields = args.selectFields;

  for (let i = 0; i < logs.length; i += 1) {
    const log = logs[i];
    const logIndex = i + 1;

    if (selectFields.length) {
      appendOutput(lines, `[${logIndex}] time=${formatLogTime(log)} container=${containerName(log)}`, state);
      const selectedText = formatSelectedLog(log, selectFields);
      if (selectedText) appendOutput(lines, selectedText, state);
      appendOutput(lines, '', state);
      continue;
    }

    const body = displayBody(log);
    const extra = args.extraFields
      .map((field) => `${field}=${compactDisplayText(fieldValue(log, field))}`)
      .join(' ');
    const headerFields = [`[${logIndex}]`];
    if (body.label !== 'content') headerFields.push(`time=${formatLogTime(log)}`);
    headerFields.push(`container=${containerName(log)}`);
    const headerBase = headerFields.join(' ');
    const header = extra ? `${headerBase} ${extra}` : headerBase;
    appendOutput(lines, header, state);
    appendOutput(lines, `${body.label}=${renderContent(body.value, args, logIndex, 0)}`, state);
    appendOutput(lines, '', state);
  }

  appendPageHint(lines, logs, args, state);
  return redactAlilogText(lines.join('\n').replace(/\n+$/, ''));
}

function captureSlsAuth(page, context, args, dependencies = {}) {
  const writeAuth = dependencies.writeAuth || writeAuthFile;
  const abortSignal = dependencies.abortSignal;
  const consoleQueryTimeoutMs = dependencies.consoleQueryTimeoutMs || SLS_AUTH_CONSOLE_QUERY_TIMEOUT_MS;
  const browserMode = dependencies.browserMode || 'headed';
  const timeoutMessage = dependencies.timeoutMessage
    || 'failed to capture SLS auth response; click Search once in the Aliyun SLS page and retry';
  let settled = false;
  let timeoutId;
  let consoleQueryTimeoutId;
  let authWriteInFlight = false;
  const cleanupFns = [];
  let settleResolve;
  let settleReject;
  const settledPromise = new Promise((resolve, reject) => {
    settleResolve = resolve;
    settleReject = reject;
  });

  function cleanup() {
    if (timeoutId) clearTimeout(timeoutId);
    timeoutId = null;
    if (consoleQueryTimeoutId) clearTimeout(consoleQueryTimeoutId);
    consoleQueryTimeoutId = null;
    while (cleanupFns.length) {
      const cleanupFn = cleanupFns.pop();
      cleanupFn();
    }
  }

  function settleSuccess(value) {
    if (settled) return;
    settled = true;
    cleanup();
    settleResolve(value);
  }

  function settleError(error) {
    if (settled) return;
    settled = true;
    cleanup();
    settleReject(error);
  }

  async function onResponse(response) {
    try {
      if (settled) return;
      let responsePath = '';
      const responseUrl = response.url();
      try {
        const url = new URL(responseUrl);
        if (url.origin !== SLS_BASE_URL) return;
        responsePath = url.pathname;
      } catch (error) {
        return;
      }
      // 用 SLS getLogs response 确认登录态有效，再从对应 request 取 x-csrf-token。
      if ((responsePath !== SLS_GET_LOGS_INDEX_PATH && responsePath !== SLS_GET_LOGS_FULL_PATH) || !response.ok()) return;
      const payload = await response.json();
      if (!payload || payload.success !== true) return;
      const csrfToken = response.request().headers()['x-csrf-token'];
      if (!csrfToken) return;
      if (settled || authWriteInFlight) return;

      authWriteInFlight = true;
      if (consoleQueryTimeoutId) clearTimeout(consoleQueryTimeoutId);
      consoleQueryTimeoutId = null;
      debugAuth(args, `csrf captured (${responsePath === SLS_GET_LOGS_INDEX_PATH ? 'logstoreindex' : 'logs'})`);
      const auth = await writeAuth(args, page, context, csrfToken);
      debugAuth(args, 'auth file written');
      settleSuccess(auth);
    } catch (error) {
      settleError(error);
    }
  }

  function startConsoleQueryTimeout() {
    if (browserMode !== 'headless'
      || settled
      || consoleQueryTimeoutId
      || typeof page.url !== 'function'
      || !isSlsConsoleUrl(page.url())) return;
    consoleQueryTimeoutId = setTimeout(() => {
      settleError(new Error('SLS console reached but no valid getLogs response was observed before the console query timeout'));
    }, consoleQueryTimeoutMs);
  }

  function onFrameNavigated(frame) {
    if (typeof page.mainFrame === 'function' && frame !== page.mainFrame()) return;
    startConsoleQueryTimeout();
  }

  // 总超时只做兜底：用户一直没有完成登录或页面没有发出 SLS 查询请求时，命令要能失败返回。
  timeoutId = setTimeout(() => {
    settleError(new Error(timeoutMessage));
  }, args.timeout * 1000);
  page.on('response', onResponse);
  cleanupFns.push(() => page.off('response', onResponse));
  page.on('framenavigated', onFrameNavigated);
  cleanupFns.push(() => page.off('framenavigated', onFrameNavigated));
  startConsoleQueryTimeout();
  if (abortSignal) {
    const onAbort = () => {
      const reason = abortSignal.reason instanceof Error
        ? abortSignal.reason
        : new Error('登录已取消或浏览器已关闭，auth 已停止。');
      settleError(reason);
    };
    if (abortSignal.aborted) {
      onAbort();
    } else {
      abortSignal.addEventListener('abort', onAbort, { once: true });
      cleanupFns.push(() => abortSignal.removeEventListener('abort', onAbort));
    }
  }
  debugAuth(args, browserMode === 'headless' ? 'waiting for SLS response' : 'waiting for SLS response; click Search if needed');
  return settledPromise;
}

function installBrowserAuthCloseHandlers(context, settleError) {
  let pageCount = 0;
  let disposed = false;
  const cleanupFns = [];

  function removeListener(target, event, listener) {
    if (typeof target.off === 'function') {
      target.off(event, listener);
      return;
    }
    if (typeof target.removeListener === 'function') target.removeListener(event, listener);
  }

  function addOnceListener(target, event, listener) {
    if (!target || typeof target.once !== 'function') return;
    target.once(event, listener);
    cleanupFns.push(() => removeListener(target, event, listener));
  }

  function addListener(target, event, listener) {
    if (!target || typeof target.on !== 'function') return;
    target.on(event, listener);
    cleanupFns.push(() => removeListener(target, event, listener));
  }

  function cancelAuth() {
    settleError(new Error('登录已取消或浏览器已关闭，auth 已停止。'));
  }

  function markPage(candidatePage) {
    if (disposed) return;
    if (!candidatePage || typeof candidatePage.once !== 'function') return;
    if (typeof candidatePage.isClosed === 'function' && candidatePage.isClosed()) return;
    pageCount += 1;
    addOnceListener(candidatePage, 'close', () => {
      pageCount = Math.max(0, pageCount - 1);
      if (pageCount === 0) cancelAuth();
    });
  }

  if (context && typeof context.once === 'function') addOnceListener(context, 'close', cancelAuth);
  if (context && typeof context.browser === 'function') {
    const browser = context.browser();
    if (browser && typeof browser.once === 'function') addOnceListener(browser, 'disconnected', cancelAuth);
  }
  if (context && typeof context.pages === 'function') {
    for (const candidatePage of context.pages()) markPage(candidatePage);
    if (typeof context.on === 'function') addListener(context, 'page', markPage);
  }
  return {
    markPage,
    getPageCount: () => pageCount,
    dispose() {
      if (disposed) return;
      disposed = true;
      while (cleanupFns.length) cleanupFns.pop()();
    },
  };
}

function formatAuthSuccessOutput() {
  return 'auth ready';
}

function reportAutoFillFailure(args, error) {
  debugAuth(args, `auto-fill failed: ${externalErrorType(error)}`);
}

async function captureAuthWithBrowser(browser, args, autoFillPlan, authMode, dependencies = {}) {
  const { context } = browser;
  const captureAuth = dependencies.captureSlsAuth || captureSlsAuth;
  const openPage = dependencies.openLoginPage || openLoginPage;
  const runAutoFill = dependencies.runAliyunAutoFillMonitor || runAliyunAutoFillMonitor;
  const authAbortController = new AbortController();
  const browserLifecycle = installBrowserAuthCloseHandlers(context, (error) => {
    if (!authAbortController.signal.aborted) authAbortController.abort(error);
  });
  try {
    const page = context.pages()[0] || await context.newPage();
    if (browserLifecycle.getPageCount() === 0) browserLifecycle.markPage(page);
    const authCaptured = captureAuth(page, context, args, {
      abortSignal: authAbortController.signal,
      browserMode: authMode.browserMode,
      timeoutMessage: authMode.browserMode === 'headless' ? 'SLS auth response was not observed' : undefined,
    });
    try {
      await openPage(page, context, args);
      if (authMode.automationMode === 'manual' && isAliyunHardCredentialFeedbackKind(authMode.feedbackKind)) {
        const manualGuidance = authMode.feedbackKind === 'password_rejected'
          ? loginPasswordRejectedManualGuidanceMessage()
          : loginTotpRejectedManualGuidanceMessage();
        await injectLoginGuidanceOnCurrentLoginPage(page, manualGuidance).catch(() => {});
      } else if (authMode.automationMode === 'manual' && autoFillPlan && !canAutoFillAliyunLogin(autoFillPlan)) {
        await injectLoginGuidanceOnCurrentLoginPage(page, loginAutoFillGuidanceMessage()).catch(() => {});
      }
      const automationTask = authMode.automationMode === 'auto-login'
        ? runAliyunAutoLoginWithFeedbackRetry(page, args, autoFillPlan, dependencies)
        : authMode.automationMode === 'auto-fill'
          ? runAutoFill(page, args, {
            autoFillPlan,
            reportNotice: dependencies.reportAuthNotice,
          })
          : Promise.resolve();

      if (authMode.automationMode === 'auto-login') {
        automationTask.catch((error) => {
          if (!authAbortController.signal.aborted) authAbortController.abort(error);
        });
      } else if (authMode.automationMode === 'auto-fill') {
        automationTask.catch((error) => reportAutoFillFailure(args, error));
      }
      await authCaptured;
    } catch (error) {
      if (!authAbortController.signal.aborted) authAbortController.abort(error);
      // 当前错误是认证失败原因；消费取消后的捕获结果，避免遗留未处理拒绝。
      await authCaptured.catch(() => undefined);
      throw error;
    }
  } finally {
    browserLifecycle.dispose();
  }
}

async function runAuthViaWorker(args, dependencies = {}) {
  const forkProcess = dependencies.forkProcess || fork;
  const worker = dependencies.spawnAuthWorker
    ? dependencies.spawnAuthWorker()
    : forkProcess(__filename, [], {
      detached: true,
      env: { ...process.env, [AUTH_WORKER_ENV]: '1' },
      stdio: ['ignore', 'ignore', 'ignore', 'ipc'],
    });
  const writeOutput = dependencies.writeStdoutLine || writeStdoutLine;
  const writeDebug = dependencies.writeDebugLine || ((line) => console.log(line));
  const writeNotice = dependencies.writeStderrLine || writeStderrLine;
  const workerArgs = {
    command: args.command,
    project: args.project,
    logstore: args.logstore,
    timeout: args.timeout,
    authFile: args.authFile,
    userFile: args.userFile,
    profileDir: args.profileDir,
    signinDomain: args.signinDomain,
    username: args.username,
    keychainService: args.keychainService,
    totpKeychainService: args.totpKeychainService,
    totpInputSelector: args.totpInputSelector,
    noAutoFill: args.noAutoFill,
    debug: args.debug,
  };

  return new Promise((resolve, reject) => {
    let settled = false;
    let noticeWritten = false;

    function detach() {
      if (worker.connected !== false && typeof worker.disconnect === 'function') worker.disconnect();
      if (typeof worker.unref === 'function') worker.unref();
    }

    function settle(callback) {
      if (settled) return;
      settled = true;
      callback();
    }

    worker.once('error', (error) => settle(() => {
      detach();
      reject(error);
    }));
    worker.once('exit', (code, signal) => settle(() => {
      detach();
      reject(new Error(`auth worker exited before reporting a result (code=${code}, signal=${signal || 'none'})`));
    }));
    worker.on('message', (message) => {
      if (!message) return;
      if (message.type === 'debug' && !settled) {
        writeDebug(message.message);
        return;
      }
      if (message.type === 'notice' && !settled && !noticeWritten) {
        noticeWritten = true;
        try {
          Promise.resolve(writeNotice(AUTH_FOREIGN_ORIGIN_HANDOFF_NOTICE)).catch(() => {});
        } catch (error) {
        }
        return;
      }
      if (message.type === 'ready') {
        settle(() => {
          Promise.resolve(writeOutput(formatAuthSuccessOutput()))
            .then(() => {
              detach();
              resolve();
            }, (error) => {
              detach();
              reject(error);
            });
        });
        return;
      }
      if (message.type === 'error') {
        settle(() => {
          detach();
          reject(new Error(message.message || 'auth worker failed'));
        });
      }
    });
    function rejectStart(error) {
      settle(() => {
        detach();
        reject(error);
      });
    }
    try {
      worker.send({ type: 'start', args: workerArgs }, (error) => {
        if (error) rejectStart(error);
      });
    } catch (error) {
      rejectStart(error);
    }
  });
}

async function runAuthInWorker(args, dependencies = {}) {
  const prepareAutoFill = dependencies.prepareAutoFillPlan || prepareAutoFillPlan;
  const createBrowserContext = dependencies.newBrowserContext || newBrowserContext;
  const captureAuth = dependencies.captureAuthWithBrowser || captureAuthWithBrowser;
  const writeOutput = dependencies.writeStdoutLine || writeStdoutLine;
  const reportReady = dependencies.reportAuthReady || (() => writeOutput(formatAuthSuccessOutput()));
  const reportNotice = dependencies.reportAuthNotice || (() => Promise.resolve());
  const reportCleanupEvent = dependencies.reportCleanupEvent
    || ((event) => debugAuth(args, event));
  const disposeBrowser = dependencies.disposeBrowserSession
    || ((candidate) => disposeBrowserSession(candidate, { ...dependencies, reportCleanupEvent }));
  const cleanupTimeoutMs = dependencies.cleanupTimeoutMs === undefined
    ? 5000
    : dependencies.cleanupTimeoutMs;
  const cleanupTasks = [];
  function startBrowserCleanup(candidate) {
    if (!candidate) return;
    cleanupTasks.push(Promise.resolve().then(() => disposeBrowser(candidate)).catch(() => {}));
  }
  const override = {};
  const hasAutomationMode = Object.prototype.hasOwnProperty.call(dependencies, 'automationMode');
  const hasBrowserMode = Object.prototype.hasOwnProperty.call(dependencies, 'browserMode');
  if (hasAutomationMode) override.automationMode = dependencies.automationMode;
  if (hasBrowserMode) override.browserMode = dependencies.browserMode;

  debugAuth(args, 'started', true);

  let autoFillPlan = null;
  let authMode;
  const hasExplicitMode = hasAutomationMode && hasBrowserMode;
  if (hasAutomationMode !== hasBrowserMode) {
    selectAliyunAuthMode(args, null, override);
  } else if (hasExplicitMode) {
    authMode = selectAliyunAuthMode(args, null, override);
    if (authMode.automationMode !== 'manual') autoFillPlan = await prepareAutoFill(args);
  } else if (args.noAutoFill) {
    authMode = selectAliyunAuthMode(args, null, override);
  } else {
    autoFillPlan = await prepareAutoFill(args);
    authMode = selectAliyunAuthMode(args, autoFillPlan, override);
  }
  let browser = null;
  try {
    if (authMode.browserMode === 'headless') {
      try {
        browser = await createBrowserContext(args, true);
        debugAuth(args, 'mode=headless');
        await captureAuth(browser, args, autoFillPlan, authMode, {
          reportAuthNotice: reportNotice,
        });
      } catch (error) {
        if (hasExplicitMode) {
          throw error;
        }
        debugAuth(args, `headless fallback: ${authDebugFailureSummary(error)}`);
        if (browser) {
          const headlessBrowser = browser;
          browser = null;
          startBrowserCleanup(headlessBrowser);
        }
        const feedbackKind = aliyunAutoLoginFeedbackKind(error);
        authMode = isAliyunHardCredentialFeedbackKind(feedbackKind)
          ? { automationMode: 'manual', browserMode: 'headed', feedbackKind }
          : { automationMode: 'auto-fill', browserMode: 'headed' };
      }
    }

    if (!browser) {
      browser = await createBrowserContext(args, false);
      debugAuth(args, 'mode=headed');
      await captureAuth(browser, args, autoFillPlan, authMode, {
        reportAuthNotice: reportNotice,
      });
    }

    await reportReady();
  } catch (error) {
    if (!dependencies.reportAuthError) throw error;
    await dependencies.reportAuthError(error);
  } finally {
    startBrowserCleanup(browser);
    await waitForBrowserCleanup(cleanupTasks, cleanupTimeoutMs);
    debugAuth(args, 'browser context cleanup finished');
  }
}

async function runAuth(args, dependencies = {}) {
  const inProcessDependencyNames = [
    'prepareAutoFillPlan',
    'newBrowserContext',
    'captureAuthWithBrowser',
    'disposeBrowserSession',
    'automationMode',
    'browserMode',
  ];
  if (inProcessDependencyNames.some((name) => Object.prototype.hasOwnProperty.call(dependencies, name))) {
    return runAuthInWorker(args, dependencies);
  }
  return runAuthViaWorker(args, dependencies);
}

async function runAuthWorkerProcess(channel = process, dependencies = {}) {
  const executeAuth = dependencies.executeAuth || runAuthInWorker;
  const exitWorker = dependencies.exit || ((code) => channel.exit(code));
  const startMessage = await new Promise((resolve, reject) => {
    channel.once('message', resolve);
    channel.once('disconnect', () => reject(new Error('auth parent disconnected before worker start')));
  });
  if (!startMessage || startMessage.type !== 'start' || !startMessage.args) {
    exitWorker(1);
    return;
  }

  let terminalSent = false;
  let noticeSent = false;
  async function reportTerminal(message) {
    if (terminalSent) return;
    terminalSent = true;
    await new Promise((resolve, reject) => {
      channel.send(message, (error) => error ? reject(error) : resolve());
    });
    if (channel.connected && typeof channel.disconnect === 'function') channel.disconnect();
  }
  const workerDependencies = {
    reportAuthNotice: () => {
      if (terminalSent || noticeSent) return;
      noticeSent = true;
      try {
        channel.send({
          type: 'notice',
          message: AUTH_FOREIGN_ORIGIN_HANDOFF_NOTICE,
        }, () => {});
      } catch (error) {
      }
    },
    reportAuthReady: () => reportTerminal({ type: 'ready' }),
    reportAuthError: (error) => reportTerminal({
      type: 'error',
      message: redactAlilogText(error && error.message ? error.message : String(error)),
    }),
  };

  try {
    await executeAuth(startMessage.args, workerDependencies);
  } catch (error) {
    await workerDependencies.reportAuthError(error).catch(() => {});
  } finally {
    exitWorker(0);
  }
}

async function run(args) {
  if (args.command === 'query') {
    const output = await queryLogsWithAuthFile(args);
    console.log(formatQueryOutput(output, args));
    if (!isSuccessfulQueryOutput(output)) process.exitCode = 1;
    return;
  }
  if (args.command === 'fields') {
    const output = await queryLogsWithAuthFile(args);
    if (!isSuccessfulQueryOutput(output)) {
      console.log(formatQueryOutput(output, args));
      process.exitCode = 1;
      return;
    }
    console.log(formatFieldsOutput(output));
    return;
  }
  if (args.command === 'logstores') {
    const output = await listLogstoresWithAuthFile(args);
    console.log(formatLogstoresOutput(output, args));
    return;
  }
  if (args.command === 'index-fields') {
    const output = await getIndexFieldsWithAuthFile(args);
    console.log(formatIndexFieldsOutput(output));
    return;
  }

  return runAuth(args);
}

